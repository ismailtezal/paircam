  "font": {
    "desktop": {
      "sans": "Geist",
      "mono": "Geist Mono",
      "size": { "xs": 11, "sm": 12, "base": 13, "md": 14, "lg": 16, "xl": 20, "xxl": 28 }
    },
    "mobile": {
      "sans": "System",
      "mono": "Menlo",
      "size": { "xs": 12, "sm": 13, "base": 15, "md": 17, "lg": 20, "xl": 28, "xxl": 34 }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "tracking": { "tight": -0.02, "normal": 0, "wide": 0.04 }
  },

  "space": {
    "0": 0, "0.5": 2, "1": 4, "1.5": 6, "2": 8, "3": 12, "4": 16,
    "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64
  },

  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "full": 9999 },

  "size": {
    "controlSm": 24,
    "controlMd": 32,
    "controlLg": 40,
    "touchTarget": 44,
    "icon": 16,
    "titleBar": 36,
    "swatch": 12
  },

  "motion": {
    "duration": { "instant": 80, "fast": 150, "base": 220, "slow": 350, "notice": 1600 },
    "easing": {
      "out": [0.23, 1, 0.32, 1],
      "inOut": [0.77, 0, 0.175, 1],
      "drawer": [0.32, 0.72, 0, 1]
    },
    "spring": {
      "snappy": { "response": 0.25, "dampingFraction": 0.9 },
      "smooth": { "response": 0.35, "dampingFraction": 1.0 },
      "gentle": { "response": 0.5, "dampingFraction": 0.85 }
    }
  }
}
